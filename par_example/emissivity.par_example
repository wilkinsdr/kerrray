outfile = ../dat/emissivity_test.dat

source = 0 5 1E-3 1.5707
V = 0

spin = 0.998

dcosalpha = 0.005
dbeta = 0.001

Nr = 100
logbin_r = 1

show_progress = 1

# Integration method: euler | rk4 | rk45 (default) | symplectic
#integrator = rk45
#rk45_tol = 1e-8
#integrator = symplectic
# Mino-time step in the strong-field region (<= 0 or omitted: 1/precision).  0.01 is a good default;
# 0.0025 for high accuracy near the photon sphere.
#symp_step = 0.01
# Composition order: 2 (Verlet), 4 or 6 (Yoshida; default 6 -- at max_tstep = 1 it is both faster and
# more accurate than order 4 at max_tstep = 0.25)
#symp_order = 6
# Far-field cap on the coordinate-time step per integration step (sets the affine step at large r,
# growing in proportion to r beyond MAXDT_RLIM = 100).  Default 1; 0.25 for ~10x better far-field
# accuracy at ~3x the cost.
#max_tstep = 1
