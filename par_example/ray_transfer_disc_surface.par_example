outfile = ../dat/ray_transfer_disc_surface.fits

# image plane (as in ray_transfer_disc_wind.par)
dist = 1000
incl = 60
spin = 0.9
plane_phi0 = 0
x0 = -30
xmax = 30
Nx = 100
y0 = -30
ymax = 30
Ny = 100
symp_step = -1
symp_order = 6
max_tstep = 0.01

# co-rotating gas layer above the disc surface (DiscSurface, rtfield.h): cylindrical radius range and
# height range above the equatorial plane. density_mode: "constant" (n0 everywhere), "radius_powerlaw"
# (n0*(R/R_in)^-density_index) or "height_powerlaw" (n0*(z/z_min)^-density_index).
R_in = 6.0
R_out = 20.0
z_min = 0.5
z_max = 5.0
density_mode = constant
n0 = 1.0
density_index = 1.0

# emitting annulus of the disc surface (DiscContinuumSource, continuum_source.h) -- must lie within
# [ISCO, r_out_disc] below
R_in_corona = 6.0
R_out_corona = 20.0
I_corona = 1.0

# full opaque disc (inner edge: ISCO); the emitting annulus above takes priority within its own range
r_out_disc = 50.0

# wind line-emission source function: "powerlaw" (recommended -- a power law in the gas layer's own
# cylindrical radius, WindSourceMode::PowerLaw, ray_transfer.h) or "density" (density_scale * density).
# There is no "illumination" option for this application -- see ray_transfer_disc_surface.cpp.
source_mode = powerlaw
density_scale = 1.0
powerlaw_norm = 1.0
powerlaw_ref_r = 6.0
powerlaw_index = 1.0

# resonance line (e.g. Fe K-alpha, keV)
line_energy = 6.4
doppler_width = 0.05
kappa0 = 0.2

# output energy grid
n_energy = 90
energy_min = 3.0
energy_max = 7.5
